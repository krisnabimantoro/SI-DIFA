generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users_posyandu {
  id            String  @id @default(uuid()) @db.Uuid
  lokasi        String? @db.VarChar
  user_id       String  @db.Uuid
  nama_posyandu String? @db.VarChar
  users         users   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model users_psikolog {
  id        String  @id @default(uuid()) @db.Uuid
  lokasi    String? @db.VarChar
  spesialis String? @db.VarChar
  user_id   String  @db.Uuid
  users     users   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model users {
  id             String           @id @default(uuid()) @db.Uuid
  name           String           @db.VarChar
  email          String           @unique @db.VarChar
  password       String           @db.VarChar
  no_telp        String?          @db.VarChar
  role           String?          @db.VarChar
  verification   String?          @db.VarChar
  created_at     DateTime?        @db.Timestamp(6)
  users_posyandu users_posyandu[]
  users_psikolog users_psikolog[]
  lowongan       lowongan[]

  informasi informasi[]
}

model lowongan {
  id                String    @id @default(uuid()) @db.Uuid
  nama_lowongan     String?   @db.VarChar
  nama_perusahaan   String?   @db.VarChar
  jenis_difasilitas String?   @db.VarChar
  jenis_pekerjaan   String?   @db.VarChar
  lokasi            String?   @db.VarChar
  deskripsi         String?   @db.Text
  file_name         String?   @db.VarChar
  status            String?   @db.VarChar
  tanggal_mulai     DateTime? @db.Timestamp(6)
  tanggal_selesai   DateTime? @db.Timestamp(6)
  created_at        DateTime? @db.Timestamp(6)
  updated_at        DateTime? @db.Timestamp(6)
  user_id           String    @db.Uuid
  users             users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model informasi {
  id         String    @id @default(uuid()) @db.Uuid
  judul      String?   @db.VarChar
  tipe       String?   @db.VarChar
  deskripsi  String?   @db.Text
  file_name  String?   @db.VarChar
  created_at DateTime? @db.Timestamp(6)
  updated_at DateTime? @db.Timestamp(6)
  user_id    String    @db.Uuid
  users      users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
