generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users_kader {
  id         String    @id @default(uuid()) @db.Uuid
  jabatan    String?   @db.VarChar
  user_id    String    @db.Uuid
  created_at DateTime? @db.Timestamp(6)
  updated_at DateTime? @db.Timestamp(6)
  deleted_at DateTime? @db.Timestamp(6)

  users          users            @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ibk            ibk[]
  kader_posyandu kader_posyandu[]
  presensi_kader presensi_kader[]

  monitoring_ibk monitoring_ibk[]
}

model kader_posyandu {
  id            String    @id @default(uuid()) @db.Uuid
  user_kader_id String    @db.Uuid
  posyandu_id   String    @db.Uuid
  created_at    DateTime? @db.Timestamp(6)
  updated_at    DateTime? @db.Timestamp(6)
  deleted_at    DateTime? @db.Timestamp(6)

  users_kader users_kader @relation(fields: [user_kader_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  posyandu    posyandu    @relation(fields: [posyandu_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model posyandu {
  id            String    @id @default(uuid()) @db.Uuid
  nama_posyandu String    @db.VarChar
  alamat        String?   @db.VarChar
  no_telp       String?   @db.VarChar
  users_id      String?   @db.Uuid
  created_at    DateTime? @db.Timestamp(6)
  updated_at    DateTime? @db.Timestamp(6)
  deleted_at    DateTime? @db.Timestamp(6)

  kader_posyandu  kader_posyandu[]
  jadwal_posyandu jadwal_posyandu[]
  presensi_kader  presensi_kader[]
  presensi_ibk    presensi_ibk[]

  users users? @relation(fields: [users_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ibk   ibk[]
}

model jadwal_posyandu {
  id             String           @id @default(uuid()) @db.Uuid
  posyandu_id    String           @db.Uuid
  nama_kegiatan  String?          @db.VarChar
  jenis_kegiatan String?          @db.VarChar
  deskripsi      String?          @db.Text
  file_name      String?          @db.VarChar
  lokasi         String?          @db.VarChar
  tanggal        DateTime?        @db.Timestamp(6)
  waktu_mulai    String?          @db.VarChar
  waktu_selesai  String?          @db.VarChar
  created_at     DateTime?        @db.Timestamp(6)
  updated_at     DateTime?        @db.Timestamp(6)
  deleted_at     DateTime?        @db.Timestamp(6)
  posyandu       posyandu         @relation(fields: [posyandu_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  presensi_kader presensi_kader[]
  presensi_ibk   presensi_ibk[]

  monitoring_ibk monitoring_ibk[]
}

model presensi_kader {
  id              String          @id @default(uuid()) @db.Uuid
  user_kader_id   String          @db.Uuid
  posyandu_id     String          @db.Uuid
  jadwal_id       String          @db.Uuid
  hadir           Boolean
  created_at      DateTime?       @db.Timestamp(6)
  updated_at      DateTime?       @db.Timestamp(6)
  deleted_at      DateTime?       @db.Timestamp(6)
  users_kader     users_kader     @relation(fields: [user_kader_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  posyandu        posyandu        @relation(fields: [posyandu_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  jadwal_posyandu jadwal_posyandu @relation(fields: [jadwal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model presensi_ibk {
  id              String          @id @default(uuid()) @db.Uuid
  user_ibk_id     String          @db.Uuid
  posyandu_id     String          @db.Uuid
  jadwal_id       String          @db.Uuid
  hadir           Boolean
  created_at      DateTime?       @db.Timestamp(6)
  updated_at      DateTime?       @db.Timestamp(6)
  deleted_at      DateTime?       @db.Timestamp(6)
  posyandu        posyandu        @relation(fields: [posyandu_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  jadwal_posyandu jadwal_posyandu @relation(fields: [jadwal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ibk             ibk             @relation(fields: [user_ibk_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model users_psikolog {
  id         String    @id @default(uuid()) @db.Uuid
  lokasi     String?   @db.VarChar
  spesialis  String?   @db.VarChar
  user_id    String    @db.Uuid
  created_at DateTime? @db.Timestamp(6)
  updated_at DateTime? @db.Timestamp(6)
  deleted_at DateTime? @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model users {
  id                String              @id @default(uuid()) @db.Uuid
  name              String              @db.VarChar
  email             String              @unique @db.VarChar
  password          String              @db.VarChar
  no_telp           String?             @db.VarChar
  role              String?             @db.VarChar
  verification      String?             @db.VarChar
  created_at        DateTime?           @db.Timestamp(6)
  updated_at        DateTime?           @db.Timestamp(6)
  deleted_at        DateTime?           @db.Timestamp(6)
  users_kader       users_kader[]
  users_psikolog    users_psikolog[]
  lowongan          lowongan[]
  informasi_edukasi informasi_edukasi[]

  posyandu posyandu[]
}

model lowongan {
  id                String    @id @default(uuid()) @db.Uuid
  nama_lowongan     String    @db.VarChar
  nama_perusahaan   String    @db.VarChar
  jenis_pekerjaan   String    @db.VarChar
  lokasi            String    @db.VarChar
  jenis_difasilitas String?   @db.VarChar
  deskripsi         String?   @db.Text
  file_name         String?   @db.VarChar
  status            String?   @db.VarChar
  tanggal_mulai     DateTime? @db.Timestamp(6)
  tanggal_selesai   DateTime? @db.Timestamp(6)
  created_at        DateTime? @db.Timestamp(6)
  updated_at        DateTime? @db.Timestamp(6)
  deleted_at        DateTime? @db.Timestamp(6)
  user_id           String    @db.Uuid
  users             users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model informasi_edukasi {
  id         String    @id @default(uuid()) @db.Uuid
  judul      String    @db.VarChar
  tipe       String    @db.VarChar
  deskripsi  String    @db.Text
  file_name  String?   @db.VarChar
  created_at DateTime? @db.Timestamp(6)
  updated_at DateTime? @db.Timestamp(6)
  deleted_at DateTime? @db.Timestamp(6)
  user_id    String    @db.Uuid
  users      users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model ibk {
  id               String            @id @default(uuid()) @db.Uuid
  nama             String?           @db.VarChar
  nik              BigInt?
  tempat_lahir     String?           @db.VarChar
  tanggal_lahir    DateTime?         @db.Timestamp(6)
  file_foto        String?           @db.VarChar
  jenis_kelamin    String?           @db.VarChar
  agama            String?           @db.VarChar
  umur             Int?
  alamat           String?           @db.VarChar
  no_telp          String?           @db.VarChar
  nama_wali        String?           @db.VarChar
  no_telp_wali     String?           @db.VarChar
  created_at       DateTime?         @db.Timestamp(6)
  updated_at       DateTime?         @db.Timestamp(6)
  deleted_at       DateTime?         @db.Timestamp(6)
  posyanduId       String?           @db.Uuid
  users_kader_id   String?           @db.Uuid
  assesmen_ibk_id  String?           @db.Uuid
  kesehatan_ibk_id String?           @db.Uuid
  detail_ibk_id    String?           @db.Uuid
  assesmen_ibk     assesmen_ibk?     @relation(fields: [assesmen_ibk_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  kesehatan_ibk    kesehatan_ibk?    @relation(fields: [kesehatan_ibk_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  posyandu         posyandu?         @relation(fields: [posyanduId], references: [id])
  users_kader      users_kader?      @relation(fields: [users_kader_id], references: [id])
  detail_ibk       detail_ibk?       @relation(fields: [detail_ibk_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  presensi_ibk     presensi_ibk[]
  disabilitas_ibk  disabilitas_ibk[]
  monitoring_ibk   monitoring_ibk[]
}

model assesmen_ibk {
  id                     String    @id @default(uuid()) @db.Uuid
  total_iq               Int?
  kategori_iq            String?   @db.VarChar
  tipe_kepribadian       String?   @db.Text
  deskripsi_kepribadian  String?   @db.Text
  potensi                String?   @db.Text
  minat                  String?   @db.Text
  bakat                  String?   @db.Text
  keterampilan           String?   @db.Text
  catatan_psikolog       String?   @db.Text
  rekomendasi_intervensi String?   @db.Text
  created_at             DateTime? @db.Timestamp(6)
  updated_at             DateTime? @db.Timestamp(6)
  deleted_at             DateTime? @db.Timestamp(6)

  ibk ibk[]
}

model kesehatan_ibk {
  id             String    @id @default(uuid()) @db.Uuid
  odgj           Boolean
  hasil_diagnosa String?   @db.Text
  jenis_bantuan  String?   @db.VarChar
  riwayat_terapi String?   @db.Text
  created_at     DateTime? @db.Timestamp(6)
  updated_at     DateTime? @db.Timestamp(6)
  deleted_at     DateTime? @db.Timestamp(6)

  ibk ibk[]
}

model detail_ibk {
  id                  String    @id @default(uuid()) @db.Uuid
  pekerjaan           String?   @db.VarChar
  pendidikan          String?   @db.VarChar
  status_perkawinan   String?   @db.VarChar
  titik_koordinat     String?   @db.VarChar
  keterangan_tambahan String?   @db.Text
  created_at          DateTime? @db.Timestamp(6)
  updated_at          DateTime? @db.Timestamp(6)
  deleted_at          DateTime? @db.Timestamp(6)

  ibk ibk[]
}

model disabilitas_ibk {
  id                   String            @id @default(uuid()) @db.Uuid
  ibk_id               String            @db.Uuid
  jenis_difabilitas_id String            @db.Uuid
  tingkat_keparahan    String?           @db.VarChar
  sejak_kapan          DateTime?         @db.Timestamp(6)
  keterangan           String?           @db.Text
  created_at           DateTime?         @db.Timestamp(6)
  updated_at           DateTime?         @db.Timestamp(6)
  deleted_at           DateTime?         @db.Timestamp(6)
  ibk                  ibk               @relation(fields: [ibk_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  jenis_difasilitas    jenis_difasilitas @relation(fields: [jenis_difabilitas_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model jenis_difasilitas {
  id              String            @id @default(uuid()) @db.Uuid
  nama            String            @db.VarChar
  deskripsi       String?           @db.Text
  created_at      DateTime?         @db.Timestamp(6)
  updated_at      DateTime?         @db.Timestamp(6)
  deleted_at      DateTime?         @db.Timestamp(6)
  disabilitas_ibk disabilitas_ibk[]
}

model monitoring_ibk {
  id                   String           @id @default(uuid()) @db.Uuid
  ibk_id               String           @db.Uuid
  jadwal_posyandu_id   String?          @db.Uuid
  keluhan              String?          @db.Text
  perilaku_baru        String?          @db.Text
  tindak_lanjut        String?          @db.Text
  fungsional_checklist String?          @db.Text
  tanggal_kunjungan    DateTime?        @db.Timestamp(6)
  kecamatan            String?          @db.VarChar
  users_kader_id       String?          @db.Uuid
  keterangan           String?          @db.Text
  created_at           DateTime?        @db.Timestamp(6)
  updated_at           DateTime?        @db.Timestamp(6)
  deleted_at           DateTime?        @db.Timestamp(6)
  ibk                  ibk              @relation(fields: [ibk_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  jadwal_posyandu      jadwal_posyandu? @relation(fields: [jadwal_posyandu_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_kader          users_kader?     @relation(fields: [users_kader_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
